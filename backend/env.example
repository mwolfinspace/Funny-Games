# Minigames Hub backend — example environment.
# Copy to backend/.env (or export these in the PM2/service manager).

# Port the backend listens on (the host gateway proxies /api/mg -> this).
PORT=8907

# Data directory (JSON-file stores: users, sessions, device_saves,
# game_stats, medals, event_log + outbox/ for emails).
# MUST be a directory the service user can write at runtime.
MG_DATA_DIR=/srv/minigames/data

# Public URL where the games are served (links in emails point there).
MG_PUBLIC_URL=https://minigames.xedryk.top

# HMAC secret used to sign the /api/mg/capabilities envelope.
# GENERATE A RANDOM, LONG VALUE and keep it private. If this secret leaks,
# an attacker can mint "gitea" feature envelopes — combination with the
# server-side origin gate is what actually protects accounts, do not rely
# on the envelope alone.
MG_SIGNING_SECRET=replace-me-with-a-long-random-string

# Extra origins allowed to receive the full (gitea-mode) capabilities.
# Comma-separated. The minigames host and the GitHub Pages copy
# (https://mwolfinspace.github.io) are already allowed by default.
MG_ALLOWED_ORIGINS=

# ── SMTP (email for verify + password reset) ───────────────────────────
# Leave SMTP_HOST empty for local/dry runs: emails are written as .eml files
# into <MG_DATA_DIR>/outbox so the flow is still testable.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@xedryk.top
SMTP_PASS=change-me
SMTP_FROM=Minigames <noreply@xedryk.top>