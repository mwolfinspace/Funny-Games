# Minigames Hub image — Node backend + Stockfish UCI engine.
# The hub image needs a native Stockfish so server-side chess AI can run here
# instead of on weak client devices. Debian ships a packaged stockfish.
#
# Built on the host on deploy (only when backend/server.js or this file
# change), tagged minigames-hub:local, then recreated via docker compose.
#
#   docker build -t minigames-hub:local .

FROM node:20-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends stockfish \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /repo
CMD ["node", "backend/server.js"]