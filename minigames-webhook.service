[Unit]
Description=Minigames Gitea Webhook Receiver (port 9099)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/webhook-minigames.py
User=root
Restart=always
RestartSec=5
Environment=WEBHOOK_PORT=9099
# Optional: set WEBHOOK_SECRET to match the Gitea webhook secret
# Environment=WEBHOOK_SECRET=<your-secret>

[Install]
WantedBy=multi-user.target